{
  "schema_version": 1,
  "name": "Generic Printer",
  "description": "Configurable baseline settings for general print providers.",
  "supported_bindings": [
    "Paperback",
    "Hardcover",
    "Perfect Bound",
    "Case Bound",
    "Saddle Stitch",
    "Spiral Bound",
    "Wire-O"
  ],
  "bleed": {"size_mm": 3},
  "safe_area": {"size_mm": 5},
  "spine_calculation_method": "generic_page_count",
  "barcode": {
    "width_mm": 50.8,
    "height_mm": 30.48,
    "placement": "back_cover_bottom_right"
  },
  "supported_paper_standards": [
    "ISO A",
    "ISO B",
    "ISO C",
    "US",
    "Square",
    "Signature/Folio",
    "Custom"
  ],
  "supported_export_formats": ["SVG", "PDF", "PNG", "JPG"],
  "default_measurement_unit": "mm",
  "extensions": {}
}
